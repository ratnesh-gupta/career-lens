{
  "name": "@careerlens/shared-types",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./generated": {
      "types": "./src/generated/openapi.ts",
      "import": "./src/generated/openapi.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "openapi:generate": "openapi-typescript ../../docs/api/openapi-v1.yaml -o ./src/generated/openapi.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.5.4"
  }
}
