# Copy to host as deploy/.env.staging — never commit secrets.

APP_NAME=CareerLens
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.staging.example.com

FRONTEND_URL=https://staging.example.com

DB_CONNECTION=pgsql
DB_HOST=your-rds-endpoint
DB_PORT=5432
DB_DATABASE=careerlens
DB_USERNAME=
DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

FILESYSTEM_DISK=s3
RESUMES_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=careerlens-staging-resumes
AWS_USE_PATH_STYLE_ENDPOINT=false

MALWARE_SCANNER=clamav
MALWARE_SCAN_REQUIRED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

AI_DRIVER=fake
CAREER_SCORE_VERSION=r1a-1.0

# Web build args (compose)
VITE_API_BASE_URL=https://api.staging.example.com/api/v1
VITE_APP_URL=https://staging.example.com
