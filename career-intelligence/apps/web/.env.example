# Point at Laravel API (real backend)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_TIMEOUT_MS=30000

# Must match interceptor localStorage key
VITE_AUTH_TOKEN_KEY=careerlens_access_token

# Feature flags
# MSW is OFF by default for real-API mode. Set true only for offline FE work.
VITE_ENABLE_MSW=false
VITE_ENABLE_DEVTOOLS=true

# Sentry
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# PostHog
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# App
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=CareerLens
