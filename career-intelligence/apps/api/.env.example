APP_NAME=CareerLens
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (docker compose service "postgres" maps host 5102 → 5432)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5102
DB_DATABASE=careerlens
DB_USERNAME=careerlens
DB_PASSWORD=careerlens

# Redis (compose maps host 5103 → 6379)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=5103

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@careerlens.local"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage — MinIO locally (API 5100, console 5101); AWS S3 in staging/prod
AWS_ACCESS_KEY_ID=careerlens
AWS_SECRET_ACCESS_KEY=careerlenssecret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=careerlens-resumes
AWS_ENDPOINT=http://127.0.0.1:5100
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=

# Resume storage disk: s3 (preferred) | local (tests/offline)
RESUMES_DISK=s3
RESUMES_MAX_UPLOAD_BYTES=5242880
RESUMES_UPLOAD_URL_TTL_MINUTES=15

# Malware scanner: passthrough | clamav | none
# Production: MALWARE_SCANNER=clamav and MALWARE_SCAN_REQUIRED=true
MALWARE_SCANNER=passthrough
MALWARE_SCAN_REQUIRED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30

AI_DRIVER=fake
CAREER_SCORE_VERSION=r1a-1.0

# SPA (apps/web Vite)
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

VITE_APP_NAME="${APP_NAME}"
